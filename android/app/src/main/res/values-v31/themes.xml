<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- A zero-length splash exit avoids the emulator reveal animation that
         stays transparent and hides the first screen. -->
    <style name="Theme.FormulaTracker" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@android:color/white</item>
        <item name="android:windowDisablePreview">true</item>
        <item name="android:windowSplashScreenBackground">@android:color/white</item>
        <item name="android:windowSplashScreenAnimationDuration">0</item>
    </style>
</resources>
